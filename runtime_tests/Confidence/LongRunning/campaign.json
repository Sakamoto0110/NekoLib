      "workerId": "E3-OBS-net9.0",
      "artifactLayoutVersion": 2,
      "enabled": true,
      "description": "NekoLib Logging, Telemetry and passive Inspection under load, failure and recovery. It owns seven faults but adopts nothing and needs no external resource, so it is the one worker that can run anywhere.",
