<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net481;net9.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NekoLib.Data.RuntimeTests.FarmDatabase.Core</RootNamespace>
    <AssemblyName>NekoLib.Data.RuntimeTests.FarmDatabase.Core</AssemblyName>
  </PropertyGroup>

  <!--
    Logging and Telemetry are here to measure the simulation, and this is the first
    place in the repository that consumes either of them. They are separate opt-in
    capabilities: Telemetry holds the live window in bounded memory, Logging carries
    the history to a rolling file. NekoLib.Core arrives transitively through both.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Data\NekoLib.Data\NekoLib.Data.csproj" />
    <ProjectReference Include="..\..\..\..\src\Mvvm\NekoLib.Mvvm\NekoLib.Mvvm.csproj" />
    <ProjectReference Include="..\..\..\..\src\Logging\NekoLib.Logging\NekoLib.Logging.csproj" />
    <ProjectReference Include="..\..\..\..\src\Telemetry\NekoLib.Telemetry\NekoLib.Telemetry.csproj" />
  </ItemGroup>

  <!--
    SQLite comes from NuGet on both target families: Microsoft.Data.Sqlite carries
    SQLitePCLRaw plus the native e_sqlite3 payload per architecture.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <!--
    OleDb is built into the .NET Framework BCL, but is a separate Windows-only
    package on modern .NET. The ACE driver itself is an OS prerequisite in both
    cases - see the scenario README.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>

</Project>
