<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    .NET Framework has no Application.SetHighDpiMode, so DPI awareness has to be
    declared here instead. Without it the app renders DPI-unaware and looks blurry
    on any scaled display, which would make the two target families look different
    for reasons that have nothing to do with the database layer under test.
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="SystemAware" />
  </System.Windows.Forms.ApplicationConfigurationSection>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>

</configuration>
