<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="PrepareAnalyzerReleaseTracking" BeforeTargets="CoreCompile">
    <Copy SourceFiles="AnalyzerReleases.Shipped.txt" DestinationFiles="$(IntermediateOutputPath)AnalyzerReleases.Shipped.md" />
    <Copy SourceFiles="AnalyzerReleases.Unshipped.txt" DestinationFiles="$(IntermediateOutputPath)AnalyzerReleases.Unshipped.md" />
    <ItemGroup>
      <AdditionalFiles Include="$(IntermediateOutputPath)AnalyzerReleases.Shipped.md" />
      <AdditionalFiles Include="$(IntermediateOutputPath)AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
  </Target>
</Project>
