<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;net9.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>

    <IsPackable>true</IsPackable>
    <PackageId>NekoLib.Watchdog</PackageId>
    <Title>NekoLib Watchdog</Title>
    <Description>Process supervision with opt-in same-executable desktop auto bootstrap, restart orchestration, crash bundling and RPC control.</Description>
    <PackageTags>nekolib;watchdog;auto-bootstrap;self-host;process-supervision;kiosk;pos</PackageTags>

  </PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows'">
		<DefineConstants>$(DefineConstants);NET_9;NET9</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net481'">
		<DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net481'">
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
    <ProjectReference Include="..\NekoLib.Watchdog.Generators\NekoLib.Watchdog.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="NekoLib.Watchdog.targets" Pack="true" PackagePath="build\NekoLib.Watchdog.targets" />
    <None Include="..\NekoLib.Watchdog.Generators\bin\$(Configuration)\netstandard2.0\NekoLib.Watchdog.Generators.dll" Pack="true" PackagePath="analyzers\dotnet\cs" />
	  <ProjectReference Include="..\..\Core\NekoLib.Core\NekoLib.Core.csproj" />
	  <ProjectReference Include="..\..\Pipes\NekoLib.Pipes\NekoLib.Pipes.csproj" />
	</ItemGroup>

</Project>
