<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;net9.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>

    <IsPackable>true</IsPackable>
    <PackageId>NekoLib.Watchdog</PackageId>
    <Title>NekoLib Watchdog</Title>
    <Description>Process supervision, restart orchestration, crash bundling and RPC control for unattended applications.</Description>
    <PackageTags>nekolib;watchdog;process-supervision;kiosk;pos</PackageTags>

  </PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows'">
		<DefineConstants>$(DefineConstants);NET_9;NET9</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net481'">
		<DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net481'">
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Core\NekoLib.Core\NekoLib.Core.csproj" />
	  <ProjectReference Include="..\..\Pipes\NekoLib.Pipes\NekoLib.Pipes.csproj" />
	</ItemGroup>

</Project>
