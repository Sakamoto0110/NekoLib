<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <AssemblyName>NekoLib.Telemetry</AssemblyName>
    <RootNamespace>NekoLib.Telemetry</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>NekoLib.Telemetry</PackageId>
    <Title>NekoLib Telemetry</Title>
    <Description>Bounded correlated operation timings, checkpoints, outcomes and snapshots.</Description>
    <PackageTags>nekolib;telemetry;timing;diagnostics;desktop</PackageTags>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefineConstants>$(DefineConstants);NEKOLIB</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net481'">
    <DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0'">
    <DefineConstants>$(DefineConstants);NET_9</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\NekoLib.Core\NekoLib.Core.csproj" />
  </ItemGroup>

</Project>
