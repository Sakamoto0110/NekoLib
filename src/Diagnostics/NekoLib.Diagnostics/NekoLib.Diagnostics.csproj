<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net481;net9.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>false</ImplicitUsings>

		<OutputType>Library</OutputType>
		<AssemblyName>NekoLib.Diagnostics</AssemblyName>
		<RootNamespace>NekoLib.Diagnostics</RootNamespace>

		<IsPackable>true</IsPackable>
		<PackageId>NekoLib.Diagnostics</PackageId>
		<Title>NekoLib Diagnostics</Title>
		<Description>Cross-platform crash orchestration and crash-bundle generation with pluggable dump writing.</Description>
		<PackageTags>nekolib;diagnostics;crash-reporting;logging;desktop</PackageTags>

		<!-- Assembly metadata: generated ONCE -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>

		<!-- CRITICAL: avoid duplicate TargetFrameworkAttribute -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

		<DefineConstants>$(DefineConstants);NEKOLIB</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0'">
		<DefineConstants>$(DefineConstants);NET_9</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net481'">
		<DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

</Project>
