<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net481;net9.0-windows</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<OutputType>Library</OutputType>

		<AssemblyName>NekoLib.Mvvm</AssemblyName>
		<RootNamespace>NekoLib.Mvvm</RootNamespace>

		<Description>Minimal, opt-in MVVM helpers (ViewModelBase, RelayCommand, RelayCommand&lt;T&gt;) — sibling to NekoLib.Navigation and independent of it. Use with WinForms, WPF, or any UI that consumes System.Windows.Input.ICommand and System.ComponentModel.INotifyPropertyChanged.</Description>

		<DefineConstants>$(DefineConstants);NEKOLIB</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net481'">
		<DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows'">
		<DefineConstants>$(DefineConstants);NET_9</DefineConstants>
	</PropertyGroup>

</Project>
