<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net481;net9.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>false</ImplicitUsings>

		<OutputType>Library</OutputType>
		<AssemblyName>NekoLib.Core</AssemblyName>
		<RootNamespace>NekoLib.Core</RootNamespace>

		<IsPackable>true</IsPackable>
		<PackageId>NekoLib.Core</PackageId>
		<Title>NekoLib Core</Title>
		<Description>Shared logging, telemetry, diagnostics and observability contracts for NekoLib, with null implementations and no package dependencies.</Description>
		<PackageTags>nekolib;contracts;logging;telemetry;desktop</PackageTags>

		<!-- Assembly metadata: generated ONCE -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>

		<!-- CRITICAL: avoid duplicate TargetFrameworkAttribute -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

		<DefineConstants>$(DefineConstants);NEKOLIB</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0'">
		<DefineConstants>$(DefineConstants);NET_9</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net481'">
		<DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

</Project>
