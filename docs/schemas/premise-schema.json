{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Sakamoto0110/NekoLib/docs/schemas/premise-schema.json",
  "schemaVersion": 1,
  "title": "NekoLib scoped premise",
  "description": "A falsifiable, scope-bound reasoning optimization. It is never implementation, product, work, validation, or evidence authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "premiseId",
    "title",
    "statement",
    "status",
    "authority",
    "scope",
    "basis",
    "freshness",
    "invalidation",
    "contradictions",
    "statusHistory",
    "supersedes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "premiseId": {
      "$ref": "#/definitions/premiseId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/definitions/status"
    },
    "authority": {
      "$ref": "#/definitions/authority"
    },
    "scope": {
      "$ref": "#/definitions/scope"
    },
    "basis": {
      "$ref": "#/definitions/basis"
    },
    "freshness": {
      "$ref": "#/definitions/freshness"
    },
    "invalidation": {
      "$ref": "#/definitions/invalidation"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/contradiction"
      }
    },
    "statusHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/statusTransition"
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/premiseId"
      }
    }
  },
  "definitions": {
    "premiseId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]*-PREMISE-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "challenged",
        "broken",
        "stale",
        "expired",
        "retired",
        "superseded"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "references"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["owner-decision", "accepted-review"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryRelativePath"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "boundaries",
        "includePaths",
        "excludePaths",
        "campaignIds",
        "permittedUses"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["repository", "campaign"]
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "includePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryPattern"
          }
        },
        "excludePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryPattern"
          }
        },
        "campaignIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          }
        },
        "permittedUses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "skip-reinspection",
              "reuse-established-contract",
              "narrow-investigation"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "campaign"
              }
            }
          },
          "then": {
            "properties": {
              "campaignIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "campaignIds": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validatedAtCommit",
        "validatedAtUtc",
        "rationale",
        "evidenceReferences"
      ],
      "properties": {
        "validatedAtCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "validatedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryRelativePath"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalidateWhenChanged", "expiresAtUtc"],
      "properties": {
        "invalidateWhenChanged": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryPattern"
          }
        },
        "expiresAtUtc": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distinctFailureThreshold", "distinctBy"],
      "properties": {
        "distinctFailureThreshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "distinctBy": {
          "type": "string",
          "const": "identity"
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity",
        "observedAtUtc",
        "category",
        "severity",
        "boundary",
        "target",
        "environment",
        "commandOrScenario",
        "observation",
        "evidenceReferences",
        "classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9.-]*-CONTRA-[0-9]{3}$"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "observedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "category": {
          "type": "string",
          "enum": [
            "source-review",
            "build",
            "focused-regression",
            "full-regression",
            "api-compatibility",
            "package",
            "package-consumer",
            "runtime",
            "interactive-ui",
            "automated-ui",
            "protocol",
            "security",
            "performance",
            "soak",
            "recovery-soak",
            "chaos-soak"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["ordinary", "critical"]
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "commandOrScenario": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryRelativePath"
          }
        },
        "classification": {
          "type": "string",
          "enum": ["qualifying", "duplicate", "rejected"]
        }
      }
    },
    "statusTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "atUtc", "reason", "evidenceReferences"],
      "properties": {
        "status": {
          "$ref": "#/definitions/status"
        },
        "atUtc": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryRelativePath"
          }
        }
      }
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.$)(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*\\[\\]]).+$"
    },
    "repositoryPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.$)(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
