<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;net9.0</TargetFrameworks>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>

    <OutputType>Library</OutputType>
    <AssemblyName>NekoLib.Diagnostics.Abstractions</AssemblyName>
    <RootNamespace>NekoLib.Diagnostics.Abstractions</RootNamespace>

    <!-- ===================================================== -->
    <!-- DESIGN-TIME ONLY PROJECT                              -->
    <!-- These MUST be false to avoid duplication when sources -->
    <!-- are included into NekoLib.Diagnostics                 -->
    <!-- ===================================================== -->

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- Optional: prevent accidental NuGet packing -->
    <IsPackable>false</IsPackable>

    <!-- Optional: keep it out of publish graphs -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0'">
    <DefineConstants>$(DefineConstants);NET_9</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net481'">
    <DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
